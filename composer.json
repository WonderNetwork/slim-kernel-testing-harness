{
    "name": "wondernetwork/slim-kernel-testing-harness",
    "type": "library",
    "require": {
        "php": ">=8.5",
        "wondernetwork/slim-kernel": "^3.0",
        "slim/http": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.89"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "WonderNetwork\\SlimKernelTestingHarness\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WonderNetwork\\SlimKernelTestingHarness\\": "./tests",
            "Acme\\Example\\": "examples/"
        }
    },
    "authors": [
        {
            "name": "Maciej Łebkowski",
            "email": "m.lebkowski@gmail.com"
        }
    ],
    "scripts": {
        "ci": [
            "test",
            "cs",
            "lint"
        ],
        "test": "@phpunit",
        "phpunit": "vendor/bin/phpunit",
        "lint": "@phpstan",
        "phpstan": "vendor/bin/phpstan --memory-limit=128M",
        "cs:check": ["@phpcs:check"],
        "phpcs": "@phpcs:check",
        "phpcs:check": "vendor/bin/php-cs-fixer check --diff",
        "phpcs:fix": "vendor/bin/php-cs-fixer fix"
    }
}
